rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users can read/write all data
    // The bot uses a service account which bypasses these rules

    match /settings/{document} {
      allow read, write: if request.auth != null;
    }

    match /scheduled_jobs/{document} {
      allow read, write: if request.auth != null;
    }

    match /logs/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // Allow delete for log clearing
      allow delete: if request.auth != null;
    }

    match /bot_commands/{document} {
      allow read, write: if request.auth != null;
    }

    match /bot_status/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /vote_workflows/{document} {
      allow read, write: if request.auth != null;
    }

    // Sports contests (fantasy football, Super Bowl props, NCAA bracket) — admin-managed
    match /contests/{document} {
      allow read, write: if request.auth != null;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
