rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Brand assets — authenticated users can read/write
    match /brand/{file=**} {
      allow read, write: if request.auth != null;
    }
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
